{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scorpio Agent",
  "version": "0.1.21",
  "identifier": "com.wzd24.localcodex",
  "build": {
    "beforeDevCommand": {
      "script": "node scripts/stage-hidden-exec.mjs && npm run dev",
      "cwd": ".."
    },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": {
      "script": "node scripts/stage-node.mjs && node scripts/stage-hidden-exec.mjs && npm run build",
      "cwd": ".."
    },
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Scorpio Agent",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "resizable": true,
        "backgroundColor": "#0e1116",
        "visible": true,
        "additionalBrowserArgs": "--enable-features=msSpeechRecognition,SpeechRecognition --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "$PICTURE/**",
          "$DOCUMENT/**",
          "$DESKTOP/**",
          "$DOWNLOAD/**",
          "$TEMP/**",
          "$APPDATA/**",
          "$LOCALDATA/**",
          "$RESOURCE/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "template": "./windows/installer.nsi"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../LICENSE": "LICENSE",
      "../vendor/app-server/": "app-server/",
      "skills/": "skills/",
      "mcp/": "mcp/",
      "../node_modules/@playwright/mcp/": "node_modules/@playwright/mcp/",
      "../node_modules/playwright/": "node_modules/playwright/",
      "../node_modules/playwright-core/": "node_modules/playwright-core/",
      "../vendor/node/node.exe": "node/node.exe",
      "bundled/hidden-exec.exe": "hidden-exec.exe"
    }
  }
}
